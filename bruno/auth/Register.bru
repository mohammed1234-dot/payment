meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Mohammed",
    "email": "gamal@gmail.com",
    "password": "{{password}}"
  }
}

script:pre-request {
  bru.setVar("email", `user${Date.now()}@example.com`);
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
