meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "gamal@gmail.com",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("accessToken", res.getBody().accessToken);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
